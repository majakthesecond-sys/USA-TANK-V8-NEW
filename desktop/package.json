{
  "name": "usa-tank-v8-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Offline-capable USA Tank V8 desktop game with optional online multiplayer",
  "main": "main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "check": "node --check main.cjs && node --check local-server.cjs && node --check test-offline.cjs",
    "test:offline": "node test-offline.cjs",
    "make:windows": "electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "electron": "43.2.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "extraResource": [
          "../public"
        ],
        "name": "USA Tank V8",
        "executableName": "USA Tank V8"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "usa_tank_v8",
            "authors": "USA Tank V8",
            "description": "Offline-capable 3D tank battle game with optional online multiplayer",
            "setupExe": "USA-Tank-V8-Setup.exe",
            "noMsi": true
          }
        }
      ]
    }
  }
}
